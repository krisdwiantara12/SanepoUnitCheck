<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAbout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBackAbout"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvAboutTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Developer & Build Identity Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_sharp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvAppIdentityTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SANEPO UNIT CHECK"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVersionBadge"
                style="@style/TechValueMono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_pass"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/status_pass_fg"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDeveloperMeta"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvBuildTechMeta"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Update Settings & In-App Updater Card -->
        <TextView
            android:id="@+id/tvUpdateHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_sharp"
            android:orientation="vertical"
            android:padding="14dp">

            <CheckBox
                android:id="@+id/cbAutoCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbIncludePreRelease"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvInstallerPermState"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnGrantInstallPerm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_badge_warn"
                android:focusable="true"
                android:textColor="@color/status_warn_fg"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvUpdateStatus"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_control_well"
                android:lineSpacingExtra="4dp"
                android:padding="10dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/pbUpdateDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent_amber"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnCheckUpdateNow"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_primary"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_on_accent"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_cloud_update"
                app:drawableTint="@color/text_on_accent" />

            <Button
                android:id="@+id/btnDownloadInstallUpdate"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_badge_pass"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:textColor="@color/status_pass_fg"
                android:textStyle="bold"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_cloud_update"
                app:drawableTint="@color/status_pass_fg" />

            <Button
                android:id="@+id/btnOpenGithubReleases"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_btn_secondary"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:textColor="@color/accent_amber_text"
                android:textSize="12sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_share_export"
                app:drawableTint="@color/accent_amber_text" />
        </LinearLayout>

        <!-- Real Field Reference & Network Privacy Transparency -->
        <TextView
            android:id="@+id/tvTechRefHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvFieldThresholds"
            style="@style/TechValueMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_sharp"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPrivacyAudit"
            style="@style/TechValueMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_sharp"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Maintenance & Cache Cleanup -->
        <TextView
            android:id="@+id/tvMaintHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_sharp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvCacheUsage"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnClearAppCache"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_reset_bin"
                    app:drawableTint="@color/text_secondary" />

                <Button
                    android:id="@+id/btnCopyBuildInfo"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:drawablePadding="6dp"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    app:drawableStartCompat="@drawable/ic_copy_clip"
                    app:drawableTint="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Footer -->
        <TextView
            android:id="@+id/tvAboutFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
