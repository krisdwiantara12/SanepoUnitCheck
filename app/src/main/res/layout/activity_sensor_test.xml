<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSensorTest"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWizardStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_badge_warn"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/status_warn_fg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBackSensor"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvSensorTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvProximityHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_badge_warn"
            android:padding="10dp"
            android:textColor="@color/status_warn_fg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Conditional Barometer Airtightness Seal Section (only shown if Sensor.TYPE_PRESSURE exists!) -->
        <TextView
            android:id="@+id/tvBaroSealHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/cardBaroSeal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_sharp"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvBaroSealStatus"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnStartBaroSealTest"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_primary"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_on_accent"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_shield_check"
                app:drawableTint="@color/text_on_accent" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvBiometricHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_sharp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvBiometricState"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary" />

            <Button
                android:id="@+id/btnTestBiometric"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_primary"
                android:focusable="true"
                android:textColor="@color/text_on_accent"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvLevelHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <com.sanepo.unitcheck.ui.views.SpiritLevelView
            android:id="@+id/spiritLevelView"
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvLiveSensorsHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvLiveSensorValues"
            style="@style/TechValueMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_sharp"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvAllSensorsHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvAllSensorsList"
            style="@style/TechValueMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card_sharp"
            android:lineSpacingExtra="3dp"
            android:padding="12dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSensorPass"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pass"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:textColor="@color/status_pass_fg"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_check_mark"
                app:drawableTint="@color/status_pass_fg" />

            <Button
                android:id="@+id/btnSensorFail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_fail"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:textColor="@color/status_fail_fg"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_cross_mark"
                app:drawableTint="@color/status_fail_fg" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
