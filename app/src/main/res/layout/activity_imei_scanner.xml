<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootImeiScanner"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnBackScanner"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_secondary"
            android:focusable="true"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvScannerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnScannerTorch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_btn_secondary"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:textColor="@color/accent_amber_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <TextureView
            android:id="@+id/scannerPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:layout_width="260dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge_warn" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvScannerStatus"
        style="@style/TechValueMono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card_sharp"
        android:lineSpacingExtra="4dp"
        android:padding="12dp"
        android:textColor="@color/text_primary" />
</LinearLayout>
