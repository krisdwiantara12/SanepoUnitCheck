<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCameraTest"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvWizardStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_badge_warn"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:textColor="@color/status_warn_fg"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnBackCamera"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="Back"
            android:focusable="true"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/tvCameraTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSpotCheckGuide"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_btn_secondary"
            android:drawablePadding="5dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_camera_lens"
            app:drawableTint="@color/text_primary" />

        <Button
            android:id="@+id/btnTorchToggle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_secondary"
            android:drawablePadding="5dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:textColor="@color/accent_amber_text"
            android:textSize="11sp"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_torch_beam"
            app:drawableTint="@color/accent_amber_text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">

        <TextureView
            android:id="@+id/cameraPreviewTexture"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tvAfLiveBadge"
            style="@style/TechValueMono"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="10dp"
            android:background="@drawable/bg_badge_ready"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="FRAME..."
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSpotCheckBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="10dp"
            android:background="@drawable/bg_card_sharp"
            android:padding="10dp"
            android:textColor="@color/accent_amber_text"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvCameraInfo"
        style="@style/TechValueMono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card_sharp"
        android:padding="10dp"
        android:textColor="@color/text_secondary" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rowZoomButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/rowLensButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCameraPass"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_pass"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:textColor="@color/status_pass_fg"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_check_mark"
            app:drawableTint="@color/status_pass_fg" />

        <Button
            android:id="@+id/btnCameraFail"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_badge_fail"
            android:drawablePadding="6dp"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:textColor="@color/status_fail_fg"
            android:textStyle="bold"
            app:drawableStartCompat="@drawable/ic_cross_mark"
            app:drawableTint="@color/status_fail_fg" />
    </LinearLayout>
</LinearLayout>
