<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:orientation="vertical">

    <!-- Top Technician Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_sanepo_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SANEPO UNIT CHECK"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLangToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_secondary"
            android:focusable="true"
            android:padding="0dp"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnOpenAbout"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="About &amp; Update Settings"
            android:focusable="true"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_about_info"
            app:tint="@color/text_primary" />

        <ImageButton
            android:id="@+id/btnOpenReport"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_btn_secondary"
            android:contentDescription="Technician Report &amp; Export"
            android:focusable="true"
            android:padding="11dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_report_doc"
            app:tint="@color/accent_amber_text" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_sharp" />

    <TextView
        android:id="@+id/tvUpdateBanner"
        style="@style/TechValueMono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_pass"
        android:clickable="true"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="44dp"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="@color/status_pass_fg"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:drawableStartCompat="@drawable/ic_cloud_update"
        app:drawableTint="@color/status_pass_fg" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp" />

</LinearLayout>
