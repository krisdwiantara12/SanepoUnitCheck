<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootBatteryDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWizardStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_badge_warn"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/status_warn_fg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBackBattery"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_btn_secondary"
                android:contentDescription="Back"
                android:focusable="true"
                android:padding="11dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvBatteryTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card_sharp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvBatteryHero"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvBatteryMeta"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvGraphHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <com.sanepo.unitcheck.ui.views.CurrentChartView
            android:id="@+id/currentChartView"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_sharp"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvStressHeader"
                style="@style/TechSectionHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <CheckBox
                android:id="@+id/cbStressTorch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:checked="true"
                android:minHeight="48dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/pbStressProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="45"
                android:progress="0"
                android:progressTint="@color/accent_amber" />

            <TextView
                android:id="@+id/tvStressStatus"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="3dp"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnStartStress"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_btn_primary"
                android:drawablePadding="8dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_on_accent"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_battery_bolt"
                app:drawableTint="@color/text_on_accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBatteryPass"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pass"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:textColor="@color/status_pass_fg"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_check_mark"
                app:drawableTint="@color/status_pass_fg" />

            <Button
                android:id="@+id/btnBatteryFail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_fail"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:textColor="@color/status_fail_fg"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_cross_mark"
                app:drawableTint="@color/status_fail_fg" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
