<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootButtonPortTest"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWizardStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_badge_warn"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/status_warn_fg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackKeys"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_secondary"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvKeysTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvKeysHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_sharp"
            android:padding="12dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvKeysHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvKeyChecklist"
            style="@style/TechValueMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_sharp"
            android:lineSpacingExtra="6dp"
            android:padding="12dp"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tvPortsHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvPortStatus"
            style="@style/TechValueMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_sharp"
            android:lineSpacingExtra="6dp"
            android:padding="12dp"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnKeysPass"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pass"
                android:focusable="true"
                android:textColor="@color/status_pass_fg"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnKeysFail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_fail"
                android:focusable="true"
                android:textColor="@color/status_fail_fg"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
