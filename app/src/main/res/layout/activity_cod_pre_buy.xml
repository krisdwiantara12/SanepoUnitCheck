<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootCodPreBuy"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_canvas"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvWizardStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_badge_warn"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:textColor="@color/status_warn_fg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackCod"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_btn_secondary"
                android:focusable="true"
                android:paddingHorizontal="14dp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvCodTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCodAutoHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/tvCodAutoSafety"
            style="@style/TechValueMono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_sharp"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:textColor="@color/text_primary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCodDialImei"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:focusable="true"
                android:textColor="@color/accent_amber_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCodOpenAccounts"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:focusable="true"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnCodOpenSecurity"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:focusable="true"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCodChecklistHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_sharp"
            android:orientation="vertical"
            android:padding="10dp">

            <CheckBox
                android:id="@+id/cbAccountClear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbImeiMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <CheckBox
                android:id="@+id/cbPhysicalOk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvCalcHeader"
            style="@style/TechSectionHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_card_sharp"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvAutoDeductionHint"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_amber_text"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/lblMarketPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etMarketPrice"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_control_well"
                android:hint="2500000"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/lblTargetProfit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etTargetProfit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_control_well"
                android:hint="250000"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/lblDefectDeduction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etDefectDeduction"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_control_well"
                android:hint="0"
                android:inputType="number"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAddBatDeduction"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="+150rb Bat"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnAddLcdDeduction"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="+500rb LCD"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnClearDeduction"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="Reset 0"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etPriceNote"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_control_well"
                android:hint="Catatan minus nego"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvMaxBuyResult"
                style="@style/TechValueMono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_badge_pass"
                android:padding="12dp"
                android:textColor="@color/status_pass_fg"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCodPass"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_pass"
                android:focusable="true"
                android:textColor="@color/status_pass_fg"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCodFail"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_badge_fail"
                android:focusable="true"
                android:textColor="@color/status_fail_fg"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
