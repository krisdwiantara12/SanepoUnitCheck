<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SanepoUnitCheck" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg_canvas</item>
        <item name="android:colorBackground">@color/bg_canvas</item>
        <item name="colorPrimary">@color/accent_amber</item>
        <item name="colorPrimaryDark">@color/bg_canvas</item>
        <item name="colorAccent">@color/accent_amber</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/bg_canvas</item>
        <item name="android:navigationBarColor">@color/bg_canvas</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
    </style>

    <style name="Theme.SanepoUnitCheck.Fullscreen" parent="Theme.SanepoUnitCheck">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="28">shortEdges</item>
    </style>

    <style name="TechSectionHeader">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent_amber_text</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TechValueMono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
