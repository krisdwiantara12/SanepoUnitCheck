<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_well" />
            <stroke android:width="2dp" android:color="@color/border_focus" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_well_pressed" />
            <stroke android:width="1dp" android:color="@color/border_control" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_well" />
            <stroke android:width="1dp" android:color="@color/border_control" />
            <corners android:radius="3dp" />
        </shape>
    </item>
</selector>
